# Copy this file to .env and fill in before first deploy:
#   cp .env.example .env && ./scripts/generate-secrets.sh

# Deploy config
DEPLOY_HOST=
BASE_PATH=

# Secrets (generated by scripts/generate-secrets.sh)
DB_PASSWORD=
ADMIN_PASSWORD=
SECRET_KEY=
PAPERLESS_API_TOKEN=

# Public URLs (set to your real URLs for production)
PAPERLESS_URL=http://localhost:8000
PAPERLESS_PUBLIC_URL=http://localhost:8000

# LLM configuration (user-supplied)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
LLM_LANGUAGE=English

# OCR configuration (user-supplied)
OCR_PROVIDER=llm
VISION_LLM_PROVIDER=openai
VISION_LLM_MODEL=gpt-4o
OCR_LANGUAGE=eng
