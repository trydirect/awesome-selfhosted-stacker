# Copy to .env and generate secrets before first deploy:
#   cp .env.example .env && ./scripts/generate-secrets.sh

# Deploy target: the server you already have.
#   DEPLOY_HOST    its IP or hostname
#   DEPLOY_USER    the user to connect as, usually root
#   SSH_KEY_PATH   your private key, the same one you already use for this
#                  server. Its public half must be in that user's
#                  ~/.ssh/authorized_keys - nothing new is installed for you.
DEPLOY_HOST=
DEPLOY_USER=root
SSH_KEY_PATH=~/.ssh/id_ed25519

# Owner login (email is yours; the password is generated)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secrets (generated by scripts/generate-secrets.sh)
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
