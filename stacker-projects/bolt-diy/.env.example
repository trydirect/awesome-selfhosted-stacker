# Stacker project configuration
# This file is committed to git. Actual secrets go in .env (gitignored).

# Deploy target (server)
DEPLOY_HOST=
BASE_PATH=

# LLM provider API keys (user-supplied, leave empty if unused)
# Primary keys are normally entered in the app UI (Settings -> Providers);
# these environment variables pre-seed the same keys for the container.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
# https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://console.x.ai/
XAI_API_KEY=
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
# https://huggingface.co/settings/tokens
HuggingFace_API_KEY=

# Optional custom provider endpoints (user-supplied)
# Point to a reachable Ollama host, e.g. host IP or host.docker.internal
OLLAMA_API_BASE_URL=
TOGETHER_API_BASE_URL=
# AWS Bedrock credentials as JSON:
# {"region": "us-east-1", "accessKeyId": "...", "secretAccessKey": "..."}
AWS_BEDROCK_CONFIG=

# Runtime tuning (upstream defaults)
VITE_LOG_LEVEL=debug
DEFAULT_NUM_CTX=32768
