# Stacker project configuration
# This file is committed to git. Actual secrets go in .env (gitignored).

# Common domain (update for production)
COMMON_DOMAIN=example.com

# Deploy target (required by stacker.yml)
DEPLOY_HOST=
BASE_PATH=

# Web UI auth — AUTH_LOGIN is the username (NOT a boolean), set a value
AUTH_LOGIN=admin

# Web UI auth password (auto-generated by generate-secrets.sh)
AUTH_PASSWORD=

# LLM provider / API keys are configured in the Web UI after first deploy.
# To pre-seed settings, use A0_SET_* vars (see upstream docs), e.g.:
# A0_SET_chat_model_provider=anthropic
# A0_SET_chat_model_name=claude-sonnet-4-5
