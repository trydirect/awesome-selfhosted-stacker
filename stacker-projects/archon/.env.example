# Stacker project configuration
# This file is committed to git. Actual secrets go in .env (gitignored).

DEPLOY_HOST=
BASE_PATH=

# AI credentials — REQUIRED in Docker: at least ONE of these must be set
# or Archon fails startup with "no_ai_credentials".
# Claude OAuth token — run `claude setup-token` locally (recommended)
CLAUDE_CODE_OAUTH_TOKEN=
# Or Anthropic API key from https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# Server-generated secrets (auto-generated by scripts/generate-secrets.sh)
# WEBHOOK_SECRET: HMAC secret for GitHub webhook signature verification —
#   copy this value into your GitHub webhook config ("Secret" field).
# TOKEN_ENCRYPTION_KEY: 64-hex key encrypting per-user GitHub tokens
#   (only used when a GitHub App is configured; rotating it invalidates
#   all stored user tokens).
WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
