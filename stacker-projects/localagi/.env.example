DEPLOY_HOST=
BASE_PATH=

# Optional: API key passed to the LLM backend (bundled LocalAI needs none; set if you point to an external API that requires one)
LOCALAGI_LLM_API_KEY=

# Optional: comma-separated keys protecting the LocalAGI UI, REST API and MCP endpoint (empty = no auth)
LOCALAGI_API_KEYS=

# Password for the LocalRecall postgres knowledge base (auto-generated by scripts/generate-secrets.sh)
POSTGRES_PASSWORD=
