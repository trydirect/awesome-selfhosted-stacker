# StackPilot — Self-Hosted AI Website Support Assistant
# Copy to .env and generate secrets before first deploy:
#   cp .env.example .env && ./scripts/generate-secrets.sh

# Secrets (generated by scripts/generate-secrets.sh)
SECRET_KEY=
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
N8N_BASIC_AUTH_PASSWORD=

# Optional: override default models (must be pulled into Ollama first)
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
EXISTING_SERVER_HOST=localhost
EXISTING_SERVER_USER=root
