# Strata — Qwen3.8-Flash-Next inference engine (OpenAI/Anthropic API on :8080).
# Copy to .env (scripts/generate-secrets.sh does it for you) and adjust.
#
# Hardware: NVIDIA GPU 12 GB+ VRAM (driver 580+, nvidia-container-toolkit),
# 32 GB+ RAM, ~80 GB free disk, x86-64 with AVX2. First start downloads
# ~70 GB of model — see upstream docs/MODELS.md for picking a size.

# Model size: Q2_0 | IQ2_XS | IQ3_XXS | IQ3_S (IQ2_XS fits 64 GB RAM)
MODEL=IQ2_XS
# Model family: qwen (original) | coder | swift | unsloth
FAMILY=qwen
# Context window in tokens (32768 recommended default)
CONTEXT=32768
# Read pictures: no | yes | cpu (AMD cards: cpu only)
VISION=no
# RAM mode: auto | on | off (on maps experts from the pack instead of RAM)
LOW_RAM=auto
# Pin one GPU by nvidia-smi index (e.g. 0); empty = setup picks
GPU=
# API key for /v1 endpoints — generated by scripts/generate-secrets.sh.
# The UI is bound to 127.0.0.1 by default; set a key before changing the
# port binding to 0.0.0.0 in docker-compose.yml.
API_KEY=
