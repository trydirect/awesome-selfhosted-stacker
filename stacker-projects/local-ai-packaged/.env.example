# local-ai-packaged - stacker project configuration.
# Committed. Real values go in .env (gitignored); scripts/generate-secrets.sh
# fills every empty secret below when the stack is first deployed.

# --- Deploy target (stacker deploy --target server) ------------------------
DEPLOY_HOST=
BASE_PATH=

# --- Ollama -----------------------------------------------------------------
# Default: Ollama on the CPU. On a machine with a GPU:
#   NVIDIA: OLLAMA_CPU_REPLICAS=0 and COMPOSE_PROFILES=gpu-nvidia
#   AMD:    OLLAMA_CPU_REPLICAS=0 and COMPOSE_PROFILES=gpu-amd
#   No local models at all: OLLAMA_CPU_REPLICAS=0
OLLAMA_CPU_REPLICAS=1
COMPOSE_PROFILES=

# --- Secrets (generated) ----------------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
WEBUI_SECRET_KEY=
FLOWISE_PASSWORD=
NEO4J_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
REDIS_AUTH=
SEARXNG_SECRET=

# --- Logins -----------------------------------------------------------------
DASHBOARD_USERNAME=supabase
FLOWISE_USERNAME=admin

# --- Supabase (defaults from supabase/docker/.env.example) -----------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=local-ai
POOLER_DB_POOL_SIZE=5
PGRST_DB_SCHEMAS=public,graphql_public
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SUPABASE_PUBLIC_URL=http://localhost:8000
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
STUDIO_DEFAULT_ORGANIZATION="Default Organization"
STUDIO_DEFAULT_PROJECT="Default Project"
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=false
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

# --- Optional ---------------------------------------------------------------
# Supabase's asymmetric API keys (see supabase/docker/utils/add-new-auth-keys.sh)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase Studio AI assistant
OPENAI_API_KEY=
ADDITIONAL_REDIRECT_URLS=
