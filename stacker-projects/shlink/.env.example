# Copy to .env and generate secrets before first deploy:
#   cp .env.example .env && ./scripts/generate-secrets.sh

# Deploy target
DEPLOY_HOST=
BASE_PATH=

# Secrets (generated by scripts/generate-secrets.sh)
DB_PASSWORD=
DB_ROOT_PASSWORD=
SECRET_KEY=

# Optional: MaxMind GeoLite2 license key for shlink's geolocation feature
GEOLITE_LICENSE_KEY=
