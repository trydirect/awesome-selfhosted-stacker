# Mailu Configuration
# Copy to .env and configure before deploy

# Domain
DOMAIN=mail.example.com

# Hostnames
HOSTNAMES=mail.example.com

# Postmaster local part (will append the local part of the admin email)
POSTMASTER=admin

# Choose how secure connections are handled
# "tls" for TLS, "starttls" for STARTTLS, "notls" for no encryption
TLS_FLAVOR=cert

# Authentication rate limit (per source IP)
AUTH_RATELIMIT=10/minute;1000/hour

# Opt-out of statistics
DISABLE_STATISTICS=false

# Message size limit in bytes (default: 50MB)
MESSAGE_SIZE_LIMIT=50000000

# Message rate limit (per user)
MESSAGE_RATELIMIT=200/day

# Webmail
WEBMAIL=none

# Antivirus
ANTIVIRUS=none

# Webdav
WEBDAV=none
