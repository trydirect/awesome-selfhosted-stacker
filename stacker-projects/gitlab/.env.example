# Copy this file to .env and fill in before first deploy:
#   cp .env.example .env && ./scripts/generate-secrets.sh

# Public config
GITLAB_DOMAIN=git.example.com

# Cloud config
HETZNER_REGION=fsn1
HETZNER_SERVER_TYPE=cpx32

# Secrets (generated by scripts/generate-secrets.sh)
GITLAB_ROOT_PASSWORD=
SECRET_KEY_BASE=
OTP_SECRET=

# GitLab Omnibus config (semicolon-separated, single line)
GITLAB_OMNIBUS_CONFIG=external_url 'http://${GITLAB_DOMAIN}'; nginx['listen_port'] = 80; nginx['listen_https'] = false; gitlab_rails['gitlab_shell_ssh_port'] = 2222; gitlab_rails['initial_root_password'] = '${GITLAB_ROOT_PASSWORD}'
