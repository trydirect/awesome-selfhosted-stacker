# Stacker project configuration
# This file is committed to git. Actual secrets go in .env (gitignored).

# Deploy target
DEPLOY_HOST=
BASE_PATH=

# OpenAI-compatible API key (user-supplied). Leave empty to configure the AI
# provider later in the Vane setup screen at http://localhost:3000 instead.
# Other providers are also supported via env: ANTHROPIC_API_KEY,
# GEMINI_API_KEY, GROQ_API_KEY, OLLAMA_BASE_URL (self-hosted Ollama).
OPENAI_API_KEY=

# OpenAI-compatible API base URL (defaults to https://api.openai.com/v1).
# Point this at any OpenAI-compatible endpoint (Groq, LM Studio, vLLM, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
