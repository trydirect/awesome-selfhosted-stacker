# Copy to .env and fill in your own values. .env is gitignored.
# Referenced by stacker-projects/*/stacker.yml at deploy time.

# Absolute path to this repo on your machine. Substituted into
# deploy.server.ssh_key (${BASE_PATH}/stacker-project-test) in every project.
BASE_PATH=~/Documents/stacker-project-examples

# Target server IP/hostname. Substituted into deploy.server.host in every
# stacker.yml under stacker-projects/. Required for `--target server` deploys.
DEPLOY_HOST=<OWN SERVER IP>

# --- Cloud provider ---
# Only needed for `--target cloud` deploys (Hetzner by default).
CLOUD_API_TOKEN=<YOUR CLOUD TOKEN>

# --- Existing-server helpers ---
# Used by ad-hoc scripts (not by stacker itself, which reads deploy.server
# from each stacker.yml). Kept in sync with DEPLOY_HOST above.
EXISTING_SERVER_HOST=<OWN SERVER IP>
EXISTING_SERVER_USER=root
# create new key with ssh-keygen and put path here
EXISTING_SERVER_KEY=<PATH_TO_PRIVATE_KEY>
